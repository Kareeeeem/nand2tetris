/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16],inc, load, reset;
    OUT out[16];

    PARTS:
    Or(a=inc, b=reset, out=change);
    Or(a=load, b=change, out=loadchange);

    Inc16(in=prev, out=plus1);

    Mux16(a=plus1, b=in, sel=load, out=in1);
    Mux16(a=in1, b=false, sel=reset, out=in2);

    Register(in=in2, load=loadchange, out=out, out=prev);
}
